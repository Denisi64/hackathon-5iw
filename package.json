{
  "name": "hackathon-5iw",
  "version": "1.0.0",
  "description": "Hackathon Comutitres x ESGI",
  "scripts": {
    "dev": "pnpm --parallel --filter @comutitres/frontend --filter @comutitres/backend dev",
    "dev:front": "pnpm --filter @comutitres/frontend dev",
    "dev:back": "pnpm --filter @comutitres/backend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {}
}

{
  "name": "@comutitres/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "test": "vitest run",
    "test:report": "mkdir -p reports && vitest run --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=html",
    "lint": "tsc --noEmit",
    "db:generate": "node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node_modules/.bin/drizzle-kit migrate",
    "db:seed": "node_modules/.bin/tsx src/db/seed.ts"
  },
  "dependencies": {
    "@adminjs/nestjs": "^7.0.0",
    "@adminjs/typeorm": "^5.0.1",
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/schedule": "^4.1.2",
    "adminjs": "^7.8.17",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "drizzle-orm": "^0.38.4",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^17.7.0",
    "typeorm": "^0.3.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.25",
